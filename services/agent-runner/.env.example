# The platform's control plane. Everything this runner is allowed to do, it does
# through here.
AGENT_RUNTIME_URL=https://<appkey>.<region>.insforge.app/functions/agent-runtime

# The shared secret that authenticates this runner to the control plane.
# Generate with:  openssl rand -hex 32
# The identical value must be stored as the AGENT_RUNNER_SECRET InsForge secret.
AGENT_RUNNER_SECRET=

# Optional. Recorded as the lease owner, so a stuck run names the machine
# holding it. Useful once there is more than one runner.
AGENT_RUNNER_ID=vps-1
